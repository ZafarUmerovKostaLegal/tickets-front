{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "{{TEAMS_VERSION}}",
  "id": "{{TEAMS_ID}}",
  "developer": {
    "name": "Kosta Legal",
    "websiteUrl": "{{HUB_ORIGIN}}",
    "privacyUrl": "{{HUB_ORIGIN}}",
    "termsOfUseUrl": "{{HUB_ORIGIN}}"
  },
  "name": {
    "short": "{{DISPLAY_NAME}}",
    "full": "{{DISPLAY_NAME}} — записи встреч в matter"
  },
  "description": {
    "short": "Во время встречи Teams сохраняет запись и расшифровку в matter.",
    "full": "Добавьте Kosta File себе (Add for me). Затем войдите в собрание и откройте Apps → Kosta File в боковой панели. Выберите matter и папку — запись и расшифровка сохранятся в Kosta Hub."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#8B2635",
  "staticTabs": [
    {
      "entityId": "kosta-file-home",
      "name": "Kosta File",
      "contentUrl": "{{ADDIN_BASE}}teams.html",
      "websiteUrl": "{{HUB_ORIGIN}}",
      "scopes": ["personal"]
    }
  ],
  "configurableTabs": [
    {
      "configurationUrl": "{{ADDIN_BASE}}teams.html?view=config",
      "canUpdateConfiguration": false,
      "scopes": ["groupChat"],
      "context": ["meetingSidePanel"],
      "meetingSurfaces": ["sidePanel"]
    }
  ],
  "permissions": ["identity"],
  "validDomains": ["{{ADDIN_HOST}}", "{{API_HOST}}", "login.microsoftonline.com"]
}
