{
  "name": "kosta-outlook-file-addin",
  "private": true,
  "version": "1.2.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run manifests:check && vite build && node scripts/publish-manifests.mjs",
    "installer": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/build.ps1",
    "typecheck": "tsc -p .",
    "test": "cd .. && npx vitest run outlook-addin",
    "manifests": "node scripts/manifests.mjs",
    "manifests:check": "node scripts/manifests.mjs --check",
    "preview": "vite preview --port 3001"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.504",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vite-plugin-mkcert": "^1.17.8"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.26.0",
    "@microsoft/teams-js": "^2.59.0",
    "@zoom/appssdk": "^0.16.43",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
