{
  "name": "tickets-front",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "twemoji:assets": "node scripts/copy-twemoji-assets.mjs",
    "attendance:export-late": "node scripts/export-attendance-late-absent.mjs",
    "dev": "node scripts/copy-twemoji-assets.mjs && vite",
    "build": "npm run twemoji:assets && tsc -p tsconfig.build.json && vite build",
    "build:production": "npm run twemoji:assets && tsc -p tsconfig.build.json && vite build --mode production",
    "build:check-budget": "node scripts/check-bundle-budget.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "build:android": "tsc -p tsconfig.build.json && vite build --mode android",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:dev:clean": "node -e \"try{require('fs').rmSync('node_modules/.vite',{recursive:true})}catch(e){}\" && tauri dev",
    "desktop:build": "tauri build",
    "android:init": "tauri android init",
    "android:adb:reverse": "adb reverse tcp:5173 tcp:5173 && adb reverse tcp:1234 tcp:1234",
    "android:dev": "npm run android:adb:reverse && tauri android dev --host 127.0.0.1",
    "android:dev:usb": "npm run android:dev",
    "android:dev:wifi": "tauri android dev",
    "android:build": "tauri android build",
    "android:build:apk": "tauri android build --apk",
    "android:build:apk:debug": "tauri android build --apk --debug",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:access": "playwright test --grep @access",
    "test:e2e:workflows": "playwright test --grep @e2e",
    "test:e2e:real-backend": "cross-env PW_REAL_BACKEND=1 playwright test --project=real-backend",
    "test:e2e:shard": "playwright test --shard=1/4",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:merge-reports": "playwright merge-reports --reporter html ./all-blob-reports",
    "test": "npm run test:unit && npm run test:e2e",
    "test:ci": "npm run test:unit && npm run test:e2e:ci",
    "ext:tt:build": "vite build --config browser-extension/tt/vite.config.ts",
    "ext:tt:dev": "vite build --config browser-extension/tt/vite.config.ts --watch"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/chrome": "^0.2.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^27.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@fontsource/carlito": "^5.2.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/react-virtual": "^3.13.26",
    "@tauri-apps/api": "^2.10.1",
    "@types/twemoji": "^13.1.1",
    "buffer": "^6.0.3",
    "core-js": "^3.49.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.6.1",
    "dompurify": "^3.3.3",
    "events": "^3.3.0",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "process": "^0.11.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.7",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0",
    "regenerator-runtime": "^0.14.1",
    "twemoji": "^14.0.2"
  }
}
